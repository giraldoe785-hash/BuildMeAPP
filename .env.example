# ============================================================================
# BuildMeAPP — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a .env.local y completa los valores reales manualmente.
# NUNCA subas secretos reales al repositorio.
# ============================================================================

# --- Base de datos PostgreSQL (Prisma 7) ---
DATABASE_URL=

# --- Diagnóstico con IA (Google Gemini) ---
GEMINI_API_KEY=

# --- Opciones de interfaz ---
NEXT_PUBLIC_SHOW_DEMO_LOGIN=false

# --- Auth.js v5 / OAuth 2.0 (Google y Microsoft Entra ID) ---
# Genera un secreto aleatorio seguro con: npx auth secret (o openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth 2.0 (Google Cloud Console -> APIs y servicios -> Credenciales)
# URI de redirección autorizada (local): http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft Entra ID (Azure Portal -> App registrations)
# URI de redirección (Web, local): http://localhost:3000/api/auth/callback/microsoft-entra-id
# Usa /common/v2.0 únicamente si la app registrada admite cuentas personales (MSA) y cuentas laborales/educativas.
# Si solo admite un directorio específico, reemplaza "common" por tu Directory (tenant) ID, o usa "consumers" solo para cuentas personales.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# --- Envío de correos transaccionales (Gmail SMTP con Nodemailer) y URL base confiable ---
# Cuenta de Gmail emisora y su contraseña de aplicación de 16 caracteres (NO uses tu contraseña normal de Gmail)
EMAIL_USER=
EMAIL_PASS=
# Dirección remitente visible (debe coincidir con la cuenta autorizada en Gmail SMTP)
EMAIL_FROM="BuildMeAPP <tu_correo@gmail.com>"
# URL pública confiable de BuildMeAPP (HTTPS en producción; http://localhost:3000 en desarrollo local)
APP_BASE_URL=http://localhost:3000
