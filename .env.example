# ============================================================================
# BuildMeAPP — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a .env.local y completa los valores reales manualmente.
# NUNCA subas secretos reales al repositorio.
# ============================================================================

# --- Base de datos PostgreSQL (Prisma 7 / Neon PostgreSQL Free) ---
# DATABASE_URL: Conexión pooled de Neon (con -pooler y sslmode=require) para el runtime de la app
DATABASE_URL=
# DIRECT_URL: Conexión directa a Neon (sin -pooler) para Prisma CLI y migraciones
DIRECT_URL=
SHADOW_DATABASE_URL=

# --- Almacenamiento de Documentos (local para desarrollo, supabase para Render Free) ---
# En desarrollo local: STORAGE_PROVIDER=local (no requiere credenciales externas)
# En Render Free: STORAGE_PROVIDER=supabase
STORAGE_PROVIDER=local
SUPABASE_URL=
# Clave secreta privada del backend (SUPABASE_SECRET_KEY) - NUNCA exponer en cliente
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=buildmeapp-private-documents

# --- Diagnóstico con IA (Google Gemini) ---
GEMINI_API_KEY=

# --- Opciones de interfaz ---
NEXT_PUBLIC_SHOW_DEMO_LOGIN=false

# --- Auth.js v5 / OAuth 2.0 (Google y Microsoft Entra ID) ---
# Genera un secreto aleatorio seguro con: openssl rand -hex 32
AUTH_SECRET=

# Google OAuth 2.0 (Google Cloud Console -> APIs y servicios -> Credenciales)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft Entra ID (Azure Portal -> App registrations)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# --- Envío de correos transaccionales (Resend HTTPS API o Gmail SMTP) ---
EMAIL_PROVIDER=smtp
# Si EMAIL_PROVIDER=resend (recomendado para Render Free):
RESEND_API_KEY=
# Si EMAIL_PROVIDER=smtp (para desarrollo local con Gmail):
EMAIL_USER=
EMAIL_PASS=
# Dirección remitente visible:
EMAIL_FROM="BuildMeAPP <tu_correo@gmail.com>"
# URL pública confiable de BuildMeAPP (HTTPS en producción / Render; http://localhost:3000 en local):
APP_BASE_URL=http://localhost:3000

# --- Pasarela de Pagos Wompi Colombia (Sandbox) ---
WOMPI_ENVIRONMENT=test
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_EVENTS_SECRET=test_events_...
WOMPI_INTEGRITY_SECRET=test_integrity_...
WOMPI_API_URL=https://sandbox.wompi.co/v1
