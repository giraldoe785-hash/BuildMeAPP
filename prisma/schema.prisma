// ============================================================
// BuildMeAPP - Prisma 7 / PostgreSQL
//
// Cambios respecto a la versión anterior (marcados con [MEJORA]):
//  1. Se CONSERVA el diagnóstico con IA (Gemini). Se agrega el catálogo
//     TipoFalla para los "casos predefinidos" (con rango de precios) y como
//     respaldo si la IA falla o se agota la cuota gratuita.
//  2. DocumentoReparador.estado pasa de texto libre a enum EstadoDocumento.
//  3. Usuario.codigoVerificacionExpiraEn: el código de verificación caduca.
//  4. Índices compuestos para las consultas más frecuentes y para las
//     llaves foráneas que no tenían índice.
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum ProveedorOAuth {
  GOOGLE
  MICROSOFT_ENTRA_ID

  @@map("proveedor_oauth")
}

enum TipoDesafioMfa {
  LOGIN_LOCAL
  LOGIN_OAUTH
  REGISTRO
  VINCULAR_CORREO

  @@map("tipo_desafio_mfa")
}

enum RolUsuario {
  CLIENTE
  REPARADOR
  ADMINISTRADOR

  @@map("rol_usuario")
}

enum EstadoCuenta {
  PENDIENTE_VERIFICACION
  EN_REVISION
  VERIFICADO
  RECHAZADO
  SUSPENDIDO

  @@map("estado_cuenta")
}

enum EstadoOrden {
  BUSCANDO
  EN_CAMINO
  EN_SITIO
  EN_TRABAJO
  FINALIZADO
  CANCELADO

  @@map("estado_orden")
}

enum ModalidadServicio {
  INMEDIATA
  PROGRAMADA

  @@map("modalidad_servicio")
}

enum MetodoDiagnostico {
  ANALISIS_IA
  CASO_PREDEFINIDO

  @@map("metodo_diagnostico")
}

// [MEJORA] Reemplaza el texto libre "pendiente" de DocumentoReparador.estado
enum EstadoDocumento {
  PENDIENTE @map("pendiente")
  APROBADO  @map("aprobado")
  RECHAZADO @map("rechazado")
  VENCIDO   @map("vencido")

  @@map("estado_documento")
}

enum EstadoCostoAdicional {
  PENDIENTE
  APROBADO
  RECHAZADO

  @@map("estado_costo_adicional")
}

enum MetodoPago {
  TARJETA
  FIXI_WALLET
  APPLE_PAY
  CASH_POS

  @@map("metodo_pago")
}

enum EstadoPago {
  PENDIENTE
  PREAUTORIZADO
  CAPTURADO
  LIBERADO
  REEMBOLSADO
  FALLIDO

  @@map("estado_pago")
}

enum TipoMovimientoWallet {
  RECARGA
  PAGO_SERVICIO
  REEMBOLSO_GARANTIA
  TRANSFERENCIA_PROPINA
  AJUSTE_COMPENSATORIO

  @@map("tipo_movimiento_wallet")
}

enum NaturalezaMovimientoWallet {
  CREDITO
  DEBITO

  @@map("naturaleza_movimiento_wallet")
}

enum EstadoRecargaWallet {
  PENDIENTE
  APROBADA
  RECHAZADA
  EN_DISPUTA
  ANULADA_WOMPI
  REVERSADA_ADMIN
  ANOMALIA_CONFIRMACION_TARDIA
  EXPIRADA_LOCALMENTE

  @@map("estado_recarga_wallet")
}

enum EstadoConciliacionRecarga {
  CONCILIADO
  PENDIENTE_INVESTIGACION
  AJUSTADO_MANUAL

  @@map("estado_conciliacion_recarga")
}

enum EstadoGarantia {
  VIGENTE
  EN_RECLAMACION
  VENCIDA
  ANULADA

  @@map("estado_garantia")
}

enum CanceladoPor {
  CLIENTE
  REPARADOR
  SISTEMA
  SOPORTE

  @@map("cancelado_por")
}

enum EstadoTicket {
  ABIERTO           @map("abierto")
  EN_GESTION        @map("en_gestion")
  EN_ESPERA_USUARIO @map("en_espera_usuario")
  RESUELTO          @map("resuelto")
  CERRADO           @map("cerrado")

  @@map("estado_ticket")
}

enum PrioridadTicket {
  BAJA    @map("baja")
  MEDIA   @map("media")
  ALTA    @map("alta")
  CRITICA @map("critica")

  @@map("prioridad_ticket")
}

enum CategoriaTicket {
  INCOMPARECENCIA         @map("incomparecencia")
  DISPUTA_COSTO           @map("disputa_costo")
  COMPORTAMIENTO_INDEBIDO @map("comportamiento_indebido")
  FALLA_TECNICA_APP       @map("falla_tecnica_app")
  GARANTIA_INCONFORME     @map("garantia_inconforme")
  OTRO                    @map("otro")

  @@map("categoria_ticket")
}

enum EstadoReclamacionGarantia {
  EN_REVISION        @map("en_revision")
  VISITA_APROBADA    @map("visita_aprobada")
  REEMBOLSO_APROBADO @map("reembolso_aprobado")
  RECHAZADA          @map("rechazada")

  @@map("estado_reclamacion_garantia")
}

enum DestinoReembolso {
  TARJETA_ORIGEN @map("tarjeta_origen")
  FIXI_WALLET    @map("fixi_wallet")

  @@map("destino_reembolso")
}

enum EstadoReembolso {
  SOLICITADO                   @map("solicitado")
  PENDIENTE_SEGUNDA_APROBACION @map("pendiente_segunda_aprobacion")
  AUTORIZADO                   @map("autorizado")
  PROCESADO                    @map("procesado")
  RECHAZADO                    @map("rechazado")
  FALLIDO                      @map("fallido")

  @@map("estado_reembolso")
}

// ============================================================
// 1. USUARIOS
// ============================================================

model Usuario {
  id            String       @id @default(uuid()) @db.Uuid
  email         String?      @unique @db.VarChar(150)
  nombreUsuario String       @unique @db.VarChar(50)
  telefono      String?      @unique @db.VarChar(30)
  passwordHash  String?      @db.VarChar(255)
  rol           RolUsuario   @default(CLIENTE)
  estado        EstadoCuenta @default(PENDIENTE_VERIFICACION)

  codigoVerificacion         String?   @db.VarChar(10)
  codigoVerificacionExpiraEn DateTime? // [MEJORA] el código debe caducar
  intentosFallidosLogin      Int       @default(0)
  bloqueadoHasta             DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  perfilCliente   PerfilCliente?
  perfilReparador PerfilReparador?

  direcciones          DireccionCliente[]
  ordenesComoCliente   OrdenServicio[]    @relation("OrdenCliente")
  ordenesComoReparador OrdenServicio[]    @relation("OrdenReparador")

  mensajesChat MensajeChat[]
  wallet       FixiWallet?

  calificacionesCliente   CalificacionServicio[] @relation("CalificacionCliente")
  calificacionesRecibidas CalificacionServicio[] @relation("CalificacionReparador")

  garantiasComoCliente   GarantiaFixiCare[] @relation("GarantiaCliente")
  garantiasComoReparador GarantiaFixiCare[] @relation("GarantiaReparador")

  ordenesIntervenidasAdmin OrdenServicio[] @relation("AdminIntervencion")

  ticketsEmitidos              TicketSoporte[]        @relation("TicketEmisor")
  ticketsAsignados             TicketSoporte[]        @relation("TicketAgente")
  mensajesSoporte              MensajeSoporte[]
  trazabilidadesOrden          OrdenTrazabilidad[]    @relation("TrazabilidadUsuario")
  reembolsosComoBeneficiario   ReembolsoTransaccion[] @relation("ReembolsoBeneficiario")
  reembolsosSolicitados        ReembolsoTransaccion[] @relation("ReembolsoSolicitante")
  reembolsosAutorizados        ReembolsoTransaccion[] @relation("ReembolsoAutorizador1")
  reembolsosSegundoAutorizador ReembolsoTransaccion[] @relation("ReembolsoAutorizador2")
  transaccionesWallet          TransaccionWallet[]
  recargasWallet               RecargaWallet[]
  permisosAsignados            UsuarioPermisoInterno[]          @relation("PermisosAsignados")
  permisosOtorgados            UsuarioPermisoInterno[]          @relation("PermisosOtorgados")
  evidenciasReclamacionSubidas EvidenciaMultimediaReclamacion[] @relation("EvidenciasSubidas")
  inspeccionesGarantiaAsignadas OrdenInspeccionGarantia[]        @relation("ReparadorInspecciones")
  intervencionesOperativas     IntervencionOperativa[]          @relation("AgenteIntervenciones")
  liquidacionesReparador       MovimientoLiquidacionReparador[] @relation("LiquidacionesReparador")
  ajustesLiquidacionAplicados  MovimientoLiquidacionReparador[] @relation("AjustesLiquidacionAutorizador")
  muestrasTelemetria           MuestraTelemetriaReparador[]     @relation("TelemetriaReparador")
  sesionUsuarios               SesionUsuario[]
  identidadesOAuth             IdentidadOAuth[]
  desafiosMfa                  DesafioMfa[]
  verificacionesCorreo         VerificacionCorreo[]
  tokensRecuperacionPassword   TokenRecuperacionPassword[]

  @@map("usuarios")
}

// ============================================================
// 2. PERFIL DEL CLIENTE
// ============================================================

model PerfilCliente {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @unique @db.Uuid
  nombres   String   @db.VarChar(100)
  apellidos String   @db.VarChar(100)
  creadoEn  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("perfiles_clientes")
}

// ============================================================
// 3. DIRECCIONES DEL CLIENTE
// ============================================================

model DireccionCliente {
  id               String   @id @default(uuid()) @db.Uuid
  clienteId        String   @db.Uuid
  alias            String   @db.VarChar(50)
  direccionTexto   String   @db.VarChar(255)
  latitud          Decimal? @db.Decimal(10, 7)
  longitud         Decimal? @db.Decimal(10, 7)
  notasAcceso      String?
  esPredeterminada Boolean  @default(false)
  creadoEn         DateTime @default(now())

  cliente Usuario @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@map("direcciones_clientes")
}

// ============================================================
// 4. PERFIL DEL REPARADOR
// ============================================================

model PerfilReparador {
  id        String @id @default(uuid()) @db.Uuid
  usuarioId String @unique @db.Uuid

  tipoDocumento   String @db.VarChar(30)
  numeroDocumento String @unique @db.VarChar(50)

  nombres   String @db.VarChar(100)
  apellidos String @db.VarChar(100)

  direccion       String?
  ciudadCobertura String  @db.VarChar(100)

  enLinea Boolean @default(false)

  latitudActual         Decimal?  @db.Decimal(10, 7)
  longitudActual        Decimal?  @db.Decimal(10, 7)
  fechaUltimaTelemetria DateTime?

  // Valores derivados (denormalizados): actualízalos en la MISMA transacción
  // que registra una calificación o cierra un trabajo, para que no se desfasen.
  calificacionPromedio     Decimal @default(0) @db.Decimal(3, 2)
  totalTrabajosCompletados Int     @default(0)

  creadoEn DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  documentos     DocumentoReparador[]    @relation("PerfilDocumentos")
  especialidades ReparadorEspecialidad[]

  @@index([enLinea, ciudadCobertura])
  @@map("perfiles_reparadores")
}

// ============================================================
// 5. DOCUMENTOS DEL REPARADOR
// ============================================================

model DocumentoReparador {
  id                 String          @id @default(uuid()) @db.Uuid
  reparadorId        String          @db.Uuid
  tipoDocumento      String          @db.VarChar(50)
  archivoUrl         String          @db.Text
  estado             EstadoDocumento @default(PENDIENTE) // [MEJORA] antes era String libre
  fechaExpiracion    DateTime?
  observacionesAdmin String?
  nombreOriginal     String?         @db.VarChar(255)
  mimeType           String?         @db.VarChar(100)
  tamanoBytes        Int?
  creadoEn           DateTime        @default(now())

  reparador PerfilReparador @relation("PerfilDocumentos", fields: [reparadorId], references: [id], onDelete: Cascade)

  @@index([reparadorId])
  @@map("documentos_reparadores")
}

// ============================================================
// 6. CATEGORÍAS DE SERVICIO
// ============================================================

model CategoriaServicio {
  id          String  @id @default(uuid()) @db.Uuid
  nombre      String  @unique @db.VarChar(100)
  slug        String  @unique @db.VarChar(100)
  descripcion String?
  iconoUrl    String?
  activo      Boolean @default(true)

  especialidades ReparadorEspecialidad[]
  ordenes        OrdenServicio[]
  tiposFalla     TipoFalla[]

  @@map("categorias_servicio")
}

// ============================================================
// 6B. TIPOS DE FALLA (catálogo de CASOS PREDEFINIDOS)
// [MEJORA] Cada categoría tiene una lista de fallas comunes con su causa
// probable, solución típica y rango de precio estimado. Alimenta la opción
// "elegir un caso predefinido" (HU-05) y sirve de respaldo si Gemini falla
// o se alcanza el límite de la cuota gratuita. Es opcional: puedes no usarla.
// ============================================================

model TipoFalla {
  id          String @id @default(uuid()) @db.Uuid
  categoriaId String @db.Uuid

  nombre         String  @db.VarChar(120)
  descripcion    String?
  causaProbable  String?
  solucionTipica String?

  precioMinimo Decimal @db.Decimal(10, 2)
  precioMaximo Decimal @db.Decimal(10, 2)

  activo Boolean @default(true)

  categoria CategoriaServicio @relation(fields: [categoriaId], references: [id])
  ordenes   OrdenServicio[]

  @@unique([categoriaId, nombre])
  @@index([categoriaId, activo])
  @@map("tipos_falla")
}

// ============================================================
// 7. ESPECIALIDADES DEL REPARADOR
// ============================================================

model ReparadorEspecialidad {
  reparadorId  String   @db.Uuid
  categoriaId  String   @db.Uuid
  acreditadoEn DateTime @default(now())

  reparador PerfilReparador   @relation(fields: [reparadorId], references: [id], onDelete: Cascade)
  categoria CategoriaServicio @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@id([reparadorId, categoriaId])
  @@map("reparador_especialidades")
}

// ============================================================
// 8. CUPONES
// ============================================================

model Cupon {
  id                  String    @id @default(uuid()) @db.Uuid
  codigo              String    @unique @db.VarChar(50)
  descuentoPorcentaje Decimal?  @db.Decimal(5, 2)
  descuentoMontoFijo  Decimal?  @db.Decimal(10, 2)
  fechaVencimiento    DateTime?
  limiteUsos          Int?
  usosActuales        Int       @default(0)
  activo              Boolean   @default(true)

  ordenes OrdenServicio[]

  @@map("cupones")
}

// ============================================================
// 9. ORDENES DE SERVICIO
// ============================================================

model OrdenServicio {
  id String @id @default(uuid()) @db.Uuid

  numeroOrden       String  @unique @db.VarChar(50)
  claveIdempotencia String? @db.VarChar(100)

  clienteId   String  @db.Uuid
  reparadorId String? @db.Uuid
  categoriaId String  @db.Uuid

  direccionServicio String   @db.VarChar(255)
  latitud           Decimal? @db.Decimal(10, 7)
  longitud          Decimal? @db.Decimal(10, 7)
  notasAcceso       String?

  modalidad       ModalidadServicio
  fechaProgramada DateTime?
  franjaHoraria   String?           @db.VarChar(50)

  // Diagnóstico: por IA (Gemini) o por caso predefinido.
  // [MEJORA] tipoFallaId (opcional) enlaza al catálogo cuando el método es
  // CASO_PREDEFINIDO; vale null cuando el diagnóstico lo generó la IA.
  metodoDiagnostico    MetodoDiagnostico
  tipoFallaId          String?           @db.Uuid
  diagnosticoCausaRaiz String?
  solucionPropuesta    String?
  archivoMultimediaUrl String?

  codigoOtp           String?   @db.VarChar(4)
  otpValidado         Boolean   @default(false)
  intentosFallidosOtp Int       @default(0)
  otpBloqueadoHasta   DateTime?

  fotoEstadoInicialUrl String?
  fotoEntregaFinalUrl  String?

  codigoOtpCierre        String?   @db.VarChar(4)
  otpCierreValidado      Boolean   @default(false)
  fechaLimiteConformidad DateTime?

  costoVisita           Decimal @default(0) @db.Decimal(10, 2)
  costoManoObraEstimado Decimal @db.Decimal(10, 2)
  costoGarantiaFixicare Decimal @default(0) @db.Decimal(10, 2)
  montoDescuento        Decimal @default(0) @db.Decimal(10, 2)

  cuponId String? @db.Uuid

  totalPreautorizado Decimal  @db.Decimal(10, 2)
  totalCobradoFinal  Decimal? @db.Decimal(10, 2)
  propina            Decimal  @default(0) @db.Decimal(10, 2)

  metodoPago MetodoPago
  estadoPago EstadoPago @default(PENDIENTE)

  pasarelaHoldId    String? @db.VarChar(100)
  pasarelaCaptureId String? @db.VarChar(100)

  estado EstadoOrden @default(BUSCANDO)

  canceladoPor        CanceladoPor?
  motivoCancelacion   String?
  penalidadAplicada   Decimal       @default(0) @db.Decimal(10, 2)
  compensacionTecnico Decimal       @default(0) @db.Decimal(10, 2)

  esIntervencionAdmin     Boolean @default(false)
  adminIntervencionId     String? @db.Uuid
  justificacionDesbloqueo String?

  fechaCreacion      DateTime  @default(now())
  fechaAsignacion    DateTime?
  fechaInicioViaje   DateTime?
  fechaArriboSitio   DateTime?
  fechaInicioTrabajo DateTime?
  fechaFinalizacion  DateTime?
  fechaCancelacion   DateTime?

  cliente   Usuario           @relation("OrdenCliente", fields: [clienteId], references: [id])
  reparador Usuario?          @relation("OrdenReparador", fields: [reparadorId], references: [id])
  categoria CategoriaServicio @relation(fields: [categoriaId], references: [id])
  tipoFalla TipoFalla?        @relation(fields: [tipoFallaId], references: [id])
  cupon     Cupon?            @relation(fields: [cuponId], references: [id])

  costosAdicionales   CostoAdicional[]
  garantia            GarantiaFixiCare?
  calificacion        CalificacionServicio?
  mensajes            MensajeChat[]
  transaccionesWallet TransaccionWallet[]
  adminIntervencion   Usuario?              @relation("AdminIntervencion", fields: [adminIntervencionId], references: [id])

  trazabilidad          OrdenTrazabilidad[]
  ticketsSoporte        TicketSoporte[]
  reembolsos            ReembolsoTransaccion[]
  reclamacionesGarantia ReclamacionGarantia[]  @relation("OrdenGarantia")
  intentosPagoWompi     IntentoPagoWompi[]
  inspeccionesGarantia  OrdenInspeccionGarantia[]        @relation("InspeccionesGarantia")
  intervencionesOperativas IntervencionOperativa[]
  liquidacionesReparador MovimientoLiquidacionReparador[]
  muestrasTelemetria    MuestraTelemetriaReparador[]

  // Nota de mantenimiento sobre concurrencia e idempotencia:
  // En PostgreSQL existe además el índice único parcial:
  //   CREATE UNIQUE INDEX "ordenes_servicio_cliente_activa_idx"
  //   ON "ordenes_servicio" ("cliente_id")
  //   WHERE "estado" IN ('BUSCANDO', 'ASIGNADO', 'EN_CAMINO', 'EN_SITIO', 'EN_PROGRESO', 'ESPERANDO_APROBACION_COSTO_EXTRA', 'DISPUTA');
  // definido en prisma/migrations/20260420000000_orders_persistence_idempotency/migration.sql.
  // Prisma 7.10 no representa índices parciales con cláusula WHERE en schema.prisma;
  // cualquier migración futura generada con `prisma migrate dev` debe inspeccionarse
  // para conservar `ordenes_servicio_cliente_activa_idx` y no emitir DROP INDEX sobre él.
  @@unique([clienteId, claveIdempotencia])
  @@unique([id, clienteId])
  @@index([clienteId])
  @@index([reparadorId])
  @@index([categoriaId])
  @@index([estado, fechaProgramada])
  @@index([estado, categoriaId]) // [MEJORA] "solicitudes BUSCANDO de mi especialidad" (HU-19)
  @@index([tipoFallaId])
  @@index([cuponId])
  @@index([adminIntervencionId])
  @@map("ordenes_servicio")
}

// ============================================================
// 10. COSTOS ADICIONALES
// ============================================================

model CostoAdicional {
  id      String @id @default(uuid()) @db.Uuid
  ordenId String @db.Uuid

  descripcion      String
  monto            Decimal @db.Decimal(10, 2)
  fotoEvidenciaUrl String

  estado EstadoCostoAdicional @default(PENDIENTE)

  pasarelaHoldIncrementalId String? @db.VarChar(100)

  fechaSolicitud DateTime  @default(now())
  fechaRespuesta DateTime?

  orden OrdenServicio @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@index([ordenId])
  @@map("costos_adicionales")
}

// ============================================================
// 11. GARANTÍA FIXICARE
// ============================================================

model GarantiaFixiCare {
  id           String @id @default(uuid()) @db.Uuid
  codigoPoliza String @unique @db.VarChar(50)

  ordenId     String @unique @db.Uuid
  clienteId   String @db.Uuid
  reparadorId String @db.Uuid

  fechaEmision     DateTime
  fechaVencimiento DateTime
  estado           EstadoGarantia @default(VIGENTE)

  certificadoPdfUrl String?

  creadoEn DateTime @default(now())

  orden     OrdenServicio @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  cliente   Usuario       @relation("GarantiaCliente", fields: [clienteId], references: [id])
  reparador Usuario       @relation("GarantiaReparador", fields: [reparadorId], references: [id])

  reclamaciones ReclamacionGarantia[]

  @@index([clienteId])
  @@index([reparadorId])
  @@index([estado, fechaVencimiento]) // [MEJORA] para marcar garantías vencidas
  @@map("garantias_fixicare")
}

// ============================================================
// 12. CALIFICACIONES
// ============================================================

model CalificacionServicio {
  id String @id @default(uuid()) @db.Uuid

  ordenId     String @unique @db.Uuid
  clienteId   String @db.Uuid
  reparadorId String @db.Uuid

  puntuacion Int // 1 a 5 (se refuerza con un CHECK, ver checks.sql)
  comentario String?

  creadoEn DateTime @default(now())

  orden     OrdenServicio @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  cliente   Usuario       @relation("CalificacionCliente", fields: [clienteId], references: [id])
  reparador Usuario       @relation("CalificacionReparador", fields: [reparadorId], references: [id])

  @@index([clienteId])
  @@index([reparadorId])
  @@map("calificaciones_servicio")
}

// ============================================================
// 13. MENSAJES DEL CHAT
// ============================================================

model MensajeChat {
  id       String @id @default(uuid()) @db.Uuid
  ordenId  String @db.Uuid
  emisorId String @db.Uuid

  contenido         String  @db.VarChar(500)
  esRespuestaRapida Boolean @default(false)
  leido             Boolean @default(false)

  creadoEn DateTime @default(now())

  orden  OrdenServicio @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  emisor Usuario       @relation(fields: [emisorId], references: [id])

  @@index([ordenId, creadoEn]) // [MEJORA] el chat siempre se lee ordenado por fecha
  @@index([emisorId])
  @@map("mensajes_chat")
}

// ============================================================
// 14. FIXI WALLET
// ============================================================

model FixiWallet {
  id        String @id @default(uuid()) @db.Uuid
  usuarioId String @unique @db.Uuid

  saldoDisponibleCentavos BigInt  @default(0)
  saldoRetenidoCentavos   BigInt  @default(0)
  bloqueadaParaDebito     Boolean @default(false)
  requiereReconciliacion  Boolean @default(false)

  saldoDisponible Decimal? @default(0) @db.Decimal(12, 2)
  saldoRetenido   Decimal? @default(0) @db.Decimal(12, 2)

  actualizadoEn DateTime @updatedAt

  usuario       Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  transacciones TransaccionWallet[]
  recargas      RecargaWallet[]

  @@unique([id, usuarioId])
  @@map("fixi_wallets")
}

// ============================================================
// 15. TRANSACCIONES WALLET
// ============================================================

model TransaccionWallet {
  id        String @id @default(uuid()) @db.Uuid
  walletId  String @db.Uuid
  usuarioId String @db.Uuid

  tipo                     TipoMovimientoWallet
  naturaleza               NaturalezaMovimientoWallet?
  montoEnCentavos          BigInt
  saldoAnteriorCentavos    BigInt?
  saldoPosteriorCentavos   BigInt?
  esLegadoSinSnapshots     Boolean                     @default(false)
  esMovimientoEnCuarentena Boolean                     @default(false)

  claveIdempotencia String  @unique @db.VarChar(100)
  referenciaExterna String? @db.VarChar(100)
  descripcion       String

  recargaId   String? @db.Uuid
  ordenId     String? @db.Uuid
  reembolsoId String? @db.Uuid
  ticketId    String? @db.Uuid

  monto    Decimal? @db.Decimal(10, 2)
  creadoEn DateTime @default(now())

  wallet    FixiWallet            @relation(fields: [walletId, usuarioId], references: [id, usuarioId], onDelete: Restrict)
  usuario   Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  recarga   RecargaWallet?        @relation(fields: [recargaId, walletId, usuarioId], references: [id, walletId, usuarioId], onDelete: Restrict)
  orden     OrdenServicio?        @relation(fields: [ordenId, usuarioId], references: [id, clienteId], onDelete: Restrict)
  reembolso ReembolsoTransaccion? @relation("TransaccionReembolso", fields: [reembolsoId, usuarioId], references: [id, clienteBeneficiarioId], onDelete: Restrict)
  ticket    TicketSoporte?        @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([walletId, creadoEn])
  @@index([usuarioId])
  @@index([recargaId])
  @@index([ordenId])
  @@index([reembolsoId])
  @@index([ticketId])
  @@map("transacciones_wallet")
}

// ============================================================
// 15B. RECARGAS WALLET
// ============================================================

model RecargaWallet {
  id        String @id @default(uuid()) @db.Uuid
  walletId  String @db.Uuid
  usuarioId String @db.Uuid

  montoEnCentavos        BigInt
  montoEnDisputaCentavos BigInt @default(0)

  estado             EstadoRecargaWallet       @default(PENDIENTE)
  estadoConciliacion EstadoConciliacionRecarga @default(CONCILIADO)

  intentoGanadorId  String? @unique @db.Uuid
  ticketSoporteId   String? @db.Uuid
  claveIdempotencia String  @unique @db.VarChar(100)

  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
  procesadoEn   DateTime?

  wallet         FixiWallet          @relation(fields: [walletId, usuarioId], references: [id, usuarioId], onDelete: Restrict)
  usuario        Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  intentoGanador IntentoPagoWompi?   @relation("RecargaIntentoGanador", fields: [intentoGanadorId], references: [id], onDelete: Restrict)
  intentos       IntentoPagoWompi[]  @relation("RecargaIntentos")
  ticketSoporte  TicketSoporte?      @relation(fields: [ticketSoporteId], references: [id], onDelete: Restrict)
  transacciones  TransaccionWallet[]

  @@unique([id, walletId, usuarioId])
  @@index([walletId])
  @@index([usuarioId])
  @@index([estado, creadoEn])
  @@index([ticketSoporteId])
  @@map("recargas_wallet")
}

// ============================================================
