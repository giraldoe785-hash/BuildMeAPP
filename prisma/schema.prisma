model ReembolsoTransaccion {
  id                String @id @default(uuid()) @db.Uuid
  numeroComprobante String @unique @db.VarChar(50)

  ordenId               String  @db.Uuid
  clienteBeneficiarioId String  @db.Uuid
  ticketId              String? @db.Uuid

  solicitanteId          String?     @db.Uuid
  esLegadoSinSolicitante Boolean     @default(false)
  rolSolicitante         RolUsuario?

