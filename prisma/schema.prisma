  errorDetalle       String?        @db.VarChar(255)
  tipoReembolso      TipoReembolso?
  claveIdempotencia  String?        @unique @db.VarChar(100)
  wompiTransactionId String?        @db.VarChar(100)
  intentoPagoWompiId String?        @db.Uuid
  estadoProveedor    String?        @db.VarChar(50)

  creadoEn    DateTime  @default(now())
  procesadoEn DateTime?

  orden                  OrdenServicio                    @relation(fields: [ordenId, clienteBeneficiarioId], references: [id, clienteId], onDelete: Restrict)
  clienteBeneficiario    Usuario                          @relation("ReembolsoBeneficiario", fields: [clienteBeneficiarioId], references: [id], onDelete: Restrict)
  ticket                 TicketSoporte?                   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  solicitante            Usuario?                         @relation("ReembolsoSolicitante", fields: [solicitanteId], references: [id], onDelete: Restrict)
  autorizador1           Usuario?                         @relation("ReembolsoAutorizador1", fields: [autorizador1Id], references: [id], onDelete: Restrict)
  autorizador2           Usuario?                         @relation("ReembolsoAutorizador2", fields: [autorizador2Id], references: [id], onDelete: Restrict)
