  @@index([clienteBeneficiarioId])
  @@index([ticketId])
  @@index([estado])
  @@index([solicitanteId])
  @@index([autorizador1Id])
  @@index([autorizador2Id])
  @@index([wompiTransactionId])
  @@index([intentoPagoWompiId])
  @@map("reembolsos_transacciones")
}

