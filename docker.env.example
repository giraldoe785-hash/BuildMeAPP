# ==============================================================================
# BuildMeAPP - Plantilla de Variables de Entorno para Docker Local (R3)
# ==============================================================================
# Instrucciones de uso:
# 1. Copie este archivo como '.env.docker' en la raíz del proyecto:
#      cp docker.env.example .env.docker
# 2. Genere contraseñas seguras y asigne los valores obligatorios en '.env.docker'.
#
# REGLAS CRÍTICAS DE SEGURIDAD:
# - '.env.docker' contiene secretos y está ignorado por Git (.gitignore).
# - NUNCA guarde contraseñas reales ni secretos en este archivo de ejemplo (docker.env.example).
# - Las variables obligatorias se presentan vacías y deben ser configuradas antes del inicio.
# - Las cadenas DATABASE_URL y SHADOW_DATABASE_URL se generan automáticamente en compose.yaml
#   a partir de APP_DB_PASSWORD; NO requiere configurarlas manualmente.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Credenciales Obligatorias de Base de Datos PostgreSQL 18
# ------------------------------------------------------------------------------
# Genere contraseñas seguras en su terminal (WSL / bash) con:
#   openssl rand -hex 32

# Contraseña del usuario administrativo 'buildmeapp_test_admin' (OBLIGATORIA)
POSTGRES_PASSWORD=

# Contraseña del rol de aplicación 'buildmeapp_test_user' (OBLIGATORIA)
APP_DB_PASSWORD=

# Nota: Los siguientes parámetros de base de datos están fijados en compose.yaml:
#   POSTGRES_USER=buildmeapp_test_admin
#   POSTGRES_DB=postgres
#   APP_DB_USER=buildmeapp_test_user
#   APP_DB_NAME=buildmeapp_orders_test
#   APP_SHADOW_DB_NAME=buildmeapp_orders_shadow_test

# ------------------------------------------------------------------------------
# 2. Autenticación y Sesiones de la Aplicación (Auth.js / NextAuth)
# ------------------------------------------------------------------------------
# Secreto criptográfico para firma de tokens y cookies de sesión (OBLIGATORIO)
# Genere una clave segura de 32 bytes con: openssl rand -hex 32
AUTH_SECRET=

# Secreto heredado (opcional si AUTH_SECRET está definido)
NEXTAUTH_SECRET=

# URL base canónica de la aplicación en el navegador local
APP_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Proveedores OAuth (Opcionales para desarrollo y pruebas locales)
# ------------------------------------------------------------------------------
# Google OAuth 2.0
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft Entra ID (Azure AD)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# ------------------------------------------------------------------------------
# 4. Servicios de Inteligencia Artificial (Google Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT=20

# ------------------------------------------------------------------------------
# 5. Servicio de Notificaciones por Correo Electrónico (SMTP / Resend)
# ------------------------------------------------------------------------------
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="BuildMeAPP Local <soporte.local@buildmeapp.test>"

# ------------------------------------------------------------------------------
# 6. Pasarela de Pagos Wompi Colombia (Entorno Sandbox para pruebas)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_API_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_ENVIRONMENT=test

# ------------------------------------------------------------------------------
# 7. Variables Públicas del Frontend (NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# Nota: La modificación de estas variables requiere reconstruir la imagen Docker:
#   docker compose --env-file .env.docker build app
NEXT_PUBLIC_SHOW_DEMO_LOGIN=true
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ------------------------------------------------------------------------------
# 8. Parámetros de Inicialización de Usuarios Administrativos (Opcional)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PROMOTE_EXISTING=false

# ------------------------------------------------------------------------------
# 9. Configuración del Servidor y Almacenamiento
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
STORAGE_DIR=/app/storage
